{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["bun", "node"],
        // loop runs from its source in the submodule, exactly as loop's own
        // dev build does — its packages ship no built dist in git. ai and zod
        // are loop's own copies, so a tool fx builds is the type loop expects.
        "paths": {
            "ai": ["./vendor/loop/packages/core/node_modules/ai"],
            "zod": ["./vendor/loop/packages/core/node_modules/zod"],
            "@notshekhar/loop-core": ["./vendor/loop/packages/core/src/index.ts"],
            "@notshekhar/loop-tui": ["./vendor/loop/packages/tui/src/index.ts"],
            "@notshekhar/loop-sandbox": ["./vendor/loop/packages/sandbox/src/index.ts"],
            "@notshekhar/loop/interactive": ["./vendor/loop/packages/cli/src/interactive/app.ts"],
            "@notshekhar/loop/ui": ["./vendor/loop/packages/cli/src/interactive/ui/text.ts"]
        }
    },
    // loop's ambient declarations (its build-time virtual modules) come along.
    "include": ["src/**/*", "test/**/*", "scripts/**/*", "vendor/loop/packages/core/src/*.d.ts"]
}
